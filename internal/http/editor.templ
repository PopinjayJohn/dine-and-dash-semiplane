package http

// The editor's templates.
//
// Three components and a fragment: the editor page, the three-way diff of a
// conflict, the preview pane's problem message, and the preview pane itself — which
// is the *same* `article` component the page route uses. That last one is the
// property that matters: a preview that was a second rendering path would be a
// second set of golden tests and a second chance to leak a secret, and §9's
// "there is exactly one render path" is why the pane has no chrome either. A
// preview that looked like a page would be a second thing that looks like a page.
//
// The editor page has no tree in the sidebar: an editor is a textarea and a
// preview side by side, and a sidebar that pushed both into a third of the screen
// is a sidebar a DM reads in order to ignore.
//
// Everything here escapes. The only unescaped value in this file is
// `renderedPage.HTML`, which is the output of the sanitising renderer, and it is
// reached through a named type rather than a `templ.Raw` at each call site.

// editorPage is the editor: a form, a textarea, a preview, and — when there is one
// — the three-way diff of a conflict.
//
// The form posts to itself with a real `action`, so it works with JavaScript off.
// That is the case that has to work: autosave is a convenience, and a form that
// only works with a script behind it is the difference between a DM editing a page
// and a DM believing they cannot.
templ editorPage(v editorView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ v.Title }</title>
			<link rel="stylesheet" href={ stylesheetPath }/>
			<script type="module" src={ datastarPath } nonce={ v.Nonce } defer></script>
			<script src={ editorScriptPath } nonce={ v.Nonce } defer></script>
		</head>
		<body class="editing">
			<a class="skip-link" href="#editor">Skip to the editor</a>
			<header class="editor-bar">
				<h1 class="page-title">
					if v.Campaign.Root != "" {
						<a class="brand" href={ v.Campaign.Root }>{ v.Campaign.Name }</a>
						<a class="editor-back" href={ v.Campaign.Root }>{ v.Page.Title }</a>
					} else {
						{ v.Page.Title }
					}
				</h1>
				<p class="page-meta" id="save-state" aria-live="polite">
					if v.Form.Creating {
						Not saved yet.
					} else {
						Saved.
					}
				</p>
			</header>
			<main class="editor" id="editor">
				if v.Form.Conflict != nil {
					@conflict(*v.Form.Conflict)
				}
				<form
					id="editor-form"
					method="post"
					action={ v.Form.Action }
					data-preview={ v.Form.Preview }
					data-autosave="1"
				>
					<input type="hidden" name="csrf" value={ v.Form.CSRF }/>
					<input type="hidden" name="etag" value={ v.Form.ETag }/>
					<div class="editor-panes">
						<div class="editor-input">
							if v.Form.Creating {
								<label for="path">Where it lives</label>
								<input type="text" id="path" name="path" value={ v.Form.Path } required autocomplete="off"/>
							}
							<label class="visually-hidden" for="markdown">The page's markdown</label>
							<textarea id="markdown" name="markdown" spellcheck="false" rows="30" required>{ v.Form.Text }</textarea>
							<p class="editor-actions">
								<button type="submit">Save</button>
								<button type="button" data-preview-button>Preview</button>
								if v.Campaign.Root != "" {
									<a href={ v.Campaign.Root }>Back to the campaign</a>
								}
							</p>
						</div>
						<div class="editor-preview">
							<h2 class="visually-hidden">Preview</h2>
							<div id="preview" class="page">
								<p class="editor-hint">
									The preview appears as you type. Nothing is saved until you press Save.
								</p>
							</div>
						</div>
					</div>
				</form>
			</main>
			<footer class="footer">
				<p>
					{ v.Footer.Version.Version }
					if v.Footer.Version.Commit != "" {
						{ " " }<code>{ v.Footer.Version.Commit }</code>
					}
				</p>
			</footer>
		</body>
	</html>
}

// conflict is the three-way diff, side by side.
//
// Three columns and no merge. **A merge is a decision about somebody's prose**, and
// a server that makes it silently is a server that has edited a DM's page without
// asking. So the three texts are shown and the human picks, and the cost of that
// decision is a DM copying a paragraph between two boxes, which is a cost this
// project is willing to pay.
//
// The incoming text is still in the textarea above this, so a refresh loses
// nothing: the form's `etag` is the *current* hash, so a DM who has taken a side
// and presses Save is saving against what is there now rather than against what
// they started from.
templ conflict(c conflictView) {
	<section class="conflict" role="alert" aria-labelledby="conflict-heading">
		<h2 id="conflict-heading">Somebody else saved this page</h2>
		<p>
			Their version is the one on disk now, and yours is still in the editor below.
			Take whichever you want — theirs or yours — and press Save. Nothing here
			overwrites anything.
		</p>
		<div class="conflict-columns">
			@diffColumn("Theirs — on disk now", c.Current)
			@diffColumn("Yours — unsaved", c.Incoming)
		</div>
		if c.Base != "" {
			<details class="conflict-base">
				<summary>What it said when you started editing</summary>
				<pre>{ c.Base }</pre>
			</details>
		} else {
			<p class="editor-hint">
				The wiki has no copy of what the page said when you started editing,
				because it was changed outside the wiki and never saved here.
			</p>
		}
	</section>
}

// diffColumn is one side of the diff, as the text. Not a line-by-line diff: a DM
// editing prose wants the two versions, not a hunk, and a hunk renderer is a
// second thing to get wrong about whitespace.
templ diffColumn(heading, text string) {
	<div class="conflict-column">
		<h3>{ heading }</h3>
		<pre>{ text }</pre>
	</div>
}

// previewProblem is what the pane says while the text is not a page yet.
//
// A normal answer and not an error: a DM typing a frontmatter fence is in that
// state for a second, and a pane that flashed a 500 while they typed would be a
// pane they stopped looking at.
templ previewProblemView(p previewProblem) {
	<p class="editor-hint">{ p.why }</p>
}
