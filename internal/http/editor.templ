package http

// The editor's templates.
//
// Three components and a fragment: the editor page, the three-way diff of a
// conflict, the preview pane's problem message, and the preview pane itself — which
// is the *same* `article` component the page route uses. That last one is the
// property that matters: a preview that was a second rendering path would be a
// second set of golden tests and a second chance to leak a secret, and §9's
// "there is exactly one render path" is why the pane has no chrome either. A
// preview that looked like a page would be a second thing that looks like a page.
//
// The editor page has no tree in the sidebar: an editor is a textarea and a
// preview side by side, and a sidebar that pushed both into a third of the screen
// is a sidebar a DM reads in order to ignore.
//
// Everything here escapes. The only unescaped value in this file is
// `renderedPage.HTML`, which is the output of the sanitising renderer, and it is
// reached through a named type rather than a `templ.Raw` at each call site.

// editorPage is the editor: a form, a textarea, a preview, and — when there is one
// — the three-way diff of a conflict.
//
// The form posts to itself with a real `action`, so it works with JavaScript off.
// That is the case that has to work: autosave is a convenience, and a form that
// only works with a script behind it is the difference between a DM editing a page
// and a DM believing they cannot.
templ editorPage(v editorView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ v.Title }</title>
			<link rel="stylesheet" href={ stylesheetPath }/>
			<script type="module" src={ datastarPath } nonce={ v.Nonce } defer></script>
			<script src={ editorScriptPath } nonce={ v.Nonce } defer></script>
		</head>
		<body class="editing">
			<a class="skip-link" href="#editor">Skip to the editor</a>
			<header class="editor-bar">
				<h1 class="page-title">
					if v.Campaign.Root != "" {
						<a class="brand" href={ v.Campaign.Root }>{ v.Campaign.Name }</a>
						<a class="editor-back" href={ v.Campaign.Root }>{ v.Page.Title }</a>
					} else {
						{ v.Page.Title }
					}
				</h1>
				<p class="page-meta" id="save-state" aria-live="polite">
					if v.Form.Creating {
						Not saved yet.
					} else {
						Saved.
					}
					// A button nobody presses is a feature nobody has, and the
					// missing half of this milestone is a button.
					if v.IsDM && v.Campaign.Root != "" {
						<a href={ usersURL(v.Campaign) }>Who has access</a>
					}
				</p>
			</header>
			<main class="editor" id="editor">
				if v.Form.Conflict != nil {
					@conflict(*v.Form.Conflict)
				}
				<form
					id="editor-form"
					method="post"
					action={ v.Form.Action }
					data-preview={ v.Form.Preview }
					data-autosave="1"
				>
					<input type="hidden" name="csrf" value={ v.Form.CSRF }/>
					<input type="hidden" name="etag" value={ v.Form.ETag }/>
					<div class="editor-panes">
						<div class="editor-input">
							if v.Form.Creating {
								<label for="path">Where it lives</label>
								<input type="text" id="path" name="path" value={ v.Form.Path } required autocomplete="off"/>
							}
							<label class="visually-hidden" for="markdown">The page's markdown</label>
							<textarea id="markdown" name="markdown" spellcheck="false" rows="30" required>{ v.Form.Text }</textarea>
							<p class="editor-actions">
								<button type="submit">Save</button>
								<button type="button" data-preview-button>Preview</button>
								if v.Campaign.Root != "" {
									<a href={ v.Campaign.Root }>Back to the campaign</a>
								}
							</p>
							if !v.Form.Creating {
								@pageTools(v)
							}
						</div>
						<div class="editor-preview">
							<h2 class="visually-hidden">Preview</h2>
							<div id="preview" class="page">
								<p class="editor-hint">
									The preview appears as you type. Nothing is saved until you press Save.
								</p>
							</div>
						</div>
					</div>
				</form>
			</main>
			<footer class="footer">
				<p>
					{ v.Footer.Version.Version }
					if v.Footer.Version.Commit != "" {
						{ " " }<code>{ v.Footer.Version.Commit }</code>
					}
				</p>
			</footer>
		</body>
	</html>
}

// pageTools is the DM's half of an editor: rename, archive, purge, and the
// history with a restore per revision.
//
// All four are POSTs to the editor's own URL with an `op`, and all four are
// behind the write gate in the handler. They are *here* rather than on a separate
// page because a DM who wants to rename a page is standing in its editor, and a
// page that gathers "the things you can do to this page" in one place is a page
// that needs to be found first.
templ pageTools(v editorView) {
	<section class="tools">
		<h2>Move it, or be rid of it</h2>
		if v.IsDM {
			<form method="post" action={ v.Form.Action } class="tool">
				<input type="hidden" name="csrf" value={ v.Form.CSRF }/>
				<input type="hidden" name="op" value="rename"/>
				<label for="to">Rename to</label>
				<input type="text" id="to" name="path" value={ v.Form.Path } autocomplete="off"/>
				<p class="editor-hint">
					Every link in the campaign that points here is followed to the new
					address. Nothing is left behind pointing at the old one.
				</p>
				<button type="submit">Rename</button>
			</form>
		}
		<form method="post" action={ v.Form.Action } class="tool">
			<input type="hidden" name="csrf" value={ v.Form.CSRF }/>
			<input type="hidden" name="op" value="archive"/>
			<p>
				<strong>Archive</strong> removes the page and keeps its history, so you
				can bring it back.
			</p>
			<button type="submit">Archive</button>
		</form>
		@purgeTool(v)
	</section>

	if len(v.History) > 0 {
		<section class="tools">
			<h2>History</h2>
			<p class="editor-hint">
				Revision N is what the page said before the edit that made N+1. Restoring
				one is a save, so it keeps what you had and can itself be undone.
			</p>
			<ul class="revisions">
				for _, revision := range v.History {
					<li>
						<span class="revision-number">Revision { revision.Rev }</span>
						<time datetime={ revision.CreatedAt }>{ revision.CreatedAt }</time>
						if revision.Message != "" {
							<span class="revision-message">{ revision.Message }</span>
						}
						<form method="post" action={ v.Form.Action } class="tool">
							<input type="hidden" name="csrf" value={ v.Form.CSRF }/>
							<input type="hidden" name="op" value="restore"/>
							<input type="hidden" name="rev" value={ revision.Rev }/>
							<input type="hidden" name="etag" value={ v.Form.ETag }/>
							<button type="submit">Put this back</button>
						</form>
					</li>
				}
			</ul>
		</section>
	}
}

// purgeTool is the one irreversible thing in the editor, so it is its own
// component and it says what goes.
//
// `TestAPurgeIsNotOfferedWithoutSayingWhatItLoses` is the test, and the typed
// confirmation in the handler is the other half: a browser's `confirm()` dialog
// is suppressed by a prefetch, is not announced by a screen reader, and a DM who
// has pressed Enter twice has a page they cannot get back.
templ purgeTool(v editorView) {
	// An `if` and not an early `return`: a templ component's children are written
	// where they are written, and a `return` in the middle of one does not skip the
	// rest of the markup -- it stops writing *this* element, which is not the same
	// thing and produced a purge button on a player's editor.
	if v.IsDM {
		@purgeToolBody(v)
	}
}

templ purgeToolBody(v editorView) {
	<form method="post" action={ v.Form.Action } class="tool tool-danger">
		<input type="hidden" name="csrf" value={ v.Form.CSRF }/>
		<input type="hidden" name="op" value="purge"/>
		<p>
			<strong>Purge</strong> throws the page, its history and every link to it
			away. There is no bringing it back and the file is not kept.
		</p>
		<label for="confirm">Type the page's path to confirm</label>
		<input type="text" id="confirm" name="confirm" value={ v.Form.Path } autocomplete="off"/>
		<button type="submit">Purge for good</button>
	</form>
}

// conflict is the three-way diff, side by side.
//
// Three columns and no merge. **A merge is a decision about somebody's prose**, and
// a server that makes it silently is a server that has edited a DM's page without
// asking. So the three texts are shown and the human picks, and the cost of that
// decision is a DM copying a paragraph between two boxes, which is a cost this
// project is willing to pay.
//
// The incoming text is still in the textarea above this, so a refresh loses
// nothing: the form's `etag` is the *current* hash, so a DM who has taken a side
// and presses Save is saving against what is there now rather than against what
// they started from.
templ conflict(c conflictView) {
	<section class="conflict" role="alert" aria-labelledby="conflict-heading">
		<h2 id="conflict-heading">Somebody else saved this page</h2>
		<p>
			Their version is the one on disk now, and yours is still in the editor below.
			Take whichever you want — theirs or yours — and press Save. Nothing here
			overwrites anything.
		</p>
		<div class="conflict-columns">
			@diffColumn("Theirs — on disk now", c.Current)
			@diffColumn("Yours — unsaved", c.Incoming)
		</div>
		if c.Base != "" {
			<details class="conflict-base">
				<summary>What it said when you started editing</summary>
				<pre>{ c.Base }</pre>
			</details>
		} else {
			<p class="editor-hint">
				The wiki has no copy of what the page said when you started editing,
				because it was changed outside the wiki and never saved here.
			</p>
		}
	</section>
}

// diffColumn is one side of the diff, as the text. Not a line-by-line diff: a DM
// editing prose wants the two versions, not a hunk, and a hunk renderer is a
// second thing to get wrong about whitespace.
templ diffColumn(heading, text string) {
	<div class="conflict-column">
		<h3>{ heading }</h3>
		<pre>{ text }</pre>
	</div>
}

// previewProblem is what the pane says while the text is not a page yet.
//
// A normal answer and not an error: a DM typing a frontmatter fence is in that
// state for a second, and a pane that flashed a 500 while they typed would be a
// pane they stopped looking at.
templ previewProblemView(p previewProblem) {
	<p class="editor-hint">{ p.why }</p>
}

// users is the campaign's principals, for a DM.
//
// The link a DM has just minted is at the top, in a box that is a different
// colour from everything else, and it is the *only* time it will be there. The
// text under it says so, because a DM who misses it and assumes they can come
// back for it will be holding a promise the wiki cannot keep — and the
// revocation button on the row is the recovery.
templ users(v usersView) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ v.Title }</title>
			<link rel="stylesheet" href={ stylesheetPath }/>
		</head>
		<body>
			<a class="skip-link" href="#content">Skip to the page</a>
			<div class="shell">
				<nav class="sidebar" aria-label="Campaign">
					<a class="brand" href={ v.Campaign.Root }>{ v.Campaign.Name }</a>
					<h2>Session</h2>
					<form method="post" action={ v.Form.Action }>
						<input type="hidden" name="csrf" value={ v.Form.CSRF }/>
						<button type="submit">Log out</button>
					</form>
				</nav>
				<main class="main" id="content">
					@usersBody(v)
				</main>
			</div>
			<footer class="footer">
				<p>{ v.Footer.Version.Version }</p>
			</footer>
		</body>
	</html>
}

templ usersBody(v usersView) {
	<h1 class="page-title">Who has access</h1>
	<p class="page-meta">
		<a href={ v.Campaign.Root }>Back to the campaign</a>
	</p>

	if v.Fresh != "" {
		<div class="fresh-link" role="status">
			<h2>Here is the link. Copy it now.</h2>
			<p>
				<strong>It will not be shown again.</strong> The wiki keeps only a
				fingerprint of it, so nobody — including this page, in a minute —
				can show it to you. If you lose it, take this person's access back
				and hand them a new one.
			</p>
			<pre>{ v.Fresh }</pre>
		</div>
	}

	<h2>People</h2>
	if len(v.List) == 0 {
		<p class="tree-empty">Nobody yet. The link below is the first one.</p>
	} else {
		<ul class="users">
			for _, person := range v.List {
				<li class={ userClass(person) }>
					<span class="user-label">{ person.Label }</span>
					<span class="user-role">{ person.Role }</span>
					<span class="user-last">Last used { person.LastUsed }</span>
					if person.Revoked {
						<span class="user-revoked">revoked</span>
					} else {
						<form method="post" action={ v.Form.Action } class="user-revoke">
							<input type="hidden" name="csrf" value={ v.Form.CSRF }/>
							<input type="hidden" name="action" value="revoke"/>
							<input type="hidden" name="id" value={ person.ID }/>
							<button type="submit">Take this access back</button>
						</form>
					}
				</li>
			}
		</ul>
	}

	<h2>Hand somebody a link</h2>
	<form method="post" action={ v.Form.Action } class="new-user">
		<input type="hidden" name="csrf" value={ v.Form.CSRF }/>
		<input type="hidden" name="action" value="new"/>
		<label for="label">Who is it for?</label>
		<input type="text" id="label" name="label" required autocomplete="off"
			placeholder="Sam (Ranger)"/>
		<label for="role">What are they?</label>
		<select id="role" name="role">
			<option value="player" selected>A player</option>
			<option value="dm">A second DM</option>
		</select>
		<button type="submit">Mint the link</button>
	</form>
	<p class="editor-hint">
		A link is a password for the whole campaign. Give one per person, hand it over
		privately, and take it back the moment somebody leaves the table.
	</p>
}

templ userClass(p principalRow) {
	if p.Revoked {
		return "user is-revoked"
	}
	return "user"
}

// # Search
//
// A dropdown of candidates and nothing else. The box is in the layout, the
// fragment is what a request swaps in, and there is no JavaScript here that knows
// how either of them works — `web/static/wiki.js` does that, and the two meet on
// three attributes this template draws and that script reads.
//
// # No result is not an error state
//
// A dropdown that says "no matches" and a dropdown that says nothing are the same
// thing to a person typing, and a red box in a dropdown is a red box in a
// dropdown. So the empty case is a sentence and nothing else, and a half-typed
// query that will not parse is the same sentence rather than a 400.

// searchResultsView is the candidate list.
templ searchResultsView(s searchFragment) {
	<div class="search-results" role="listbox" aria-label="Search results">
		if len(s.Candidates) == 0 {
			<p class="search-empty">Nothing matches that yet.</p>
		} else {
			for _, c := range s.Candidates {
				@searchCandidateRow(c)
			}
		}
	</div>
}

// searchCandidateRow is one candidate, as a link a keyboard can reach.
//
// It is a link and not a `div` with a click handler: a dropdown of results that
// cannot be tabbed into or opened with the keyboard is a dropdown that does not
// work for the person most likely to be reading a campaign on a phone with a
// screen reader. `role="option"` with `aria-selected="false"` is what a combobox's
// listbox wants, and the roles are on the container and the rows rather than on
// the input, which is where the input's own `role="combobox"` lives.
templ searchCandidateRow(c candidate) {
	<a
		class="search-hit"
		role="option"
		aria-selected="false"
		href={ c.URL }
	>
		<span class="search-hit-title">{ c.Title }</span>
		<span class="search-hit-kind">{ c.Kind }</span>
		// The path, because two pages can have the same title and the DM is
		// looking for a path as often as a name.
		<span class="search-hit-path">{ c.Path }</span>
		if c.Secret {
			// Not a badge about the page, a note about *this result*: it came from
			// the private index, so it matched in a secret block. A player searching
			// their own character page and finding it here is the point of that
			// index, and a dropdown that hid it would be lying.
			<span class="search-hit-secret">from a secret</span>
		}
		if c.Snippet != "" {
			<p class="search-hit-snippet">{ c.Snippet }</p>
		}
	</a>
}
